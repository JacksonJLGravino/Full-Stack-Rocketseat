{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],

    "paths": {
      "@/*": ["./src/*"]
    },

    "module": "ESNext",
    "moduleResolution": "Bundler",

    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    "strict": true,
    "skipDefaultLibCheck": true
  }
}
